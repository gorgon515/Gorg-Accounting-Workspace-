# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Brain (two engines) ---
# "local"  = Ollama, fully on-device, NO API key. Install https://ollama.com
#            then run: ollama pull qwen2.5:7b
# "claude" = Anthropic API (strongest reasoning; needs ANTHROPIC_API_KEY).
# Default: claude if ANTHROPIC_API_KEY is set, otherwise local.
BRAIN_ENGINE=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional — only for the claude engine:
ANTHROPIC_API_KEY=
ARIA_MODEL=claude-opus-4-8

# Wake word the Web Speech fallback listens for (case-insensitive). Default: "aria".
ARIA_WAKE_WORD=aria

# Optional: extra persona / behavior appended to the brain's system prompt.
# e.g. "Be terse. Address me as 'Chief'. Prefer European exchanges."
ARIA_PERSONA=

# --- Voice recognition (push-to-talk) ---
# Default engine is fully LOCAL: on-device Whisper (transformers.js). Audio
# never leaves your machine; only the model weights download once.
#   npm install      (pulls optional @huggingface/transformers)
#   npm run model    (optional: pre-download weights so it's offline-ready)
# Engine: "local" (default) or "whisper-api" (cloud, opt-in).
STT_ENGINE=local
# Local model — tiny.en is fast; use base.en/small.en for more accuracy.
WHISPER_MODEL=Xenova/whisper-tiny.en
STT_MODEL_DIR=

# Only used if STT_ENGINE=whisper-api:
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Productivity: Google (Gmail + Calendar) ---
# Create an OAuth client of type "Desktop app" in Google Cloud Console, enable
# the Gmail API and Google Calendar API, then paste the client id/secret here.
# Read-only scopes are requested. Leave blank to disable Google features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Trading account (Alpaca) ---
# You do NOT put broker keys here — connect them in the app's Connections panel
# (stored encrypted on-device). Paper is the default; live is opt-in.
