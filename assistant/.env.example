# ====================================================================
# ARIA configuration. Copy THIS file to ".env" in this same folder
# (assistant/.env) and fill in what you want. .env is gitignored —
# never commit real keys.
#
# YOU CAN RUN ARIA WITH ZERO KEYS: free Yahoo market data + a local Ollama
# brain + the TradingView charts + paper trading all work with nothing below.
# Every key here is OPTIONAL and has a FREE tier — each block says where to
# get one and where it goes:
#   • Finnhub   (real-time quotes)   — FREE key   → MARKETDATA_API_KEY
#   • Google    (calendar add/read)  — FREE OAuth → GOOGLE_CLIENT_ID/SECRET
#   • Alpaca    (paper trading)      — FREE keys  → entered IN the app, not here
#   • Anthropic (stronger AI brain)  — PAID, optional → ANTHROPIC_API_KEY
# ====================================================================

# --- Brain ---
# Default: FULLY LOCAL, no API key. Runs an Ollama model on your machine.
#   1) Install Ollama: https://ollama.com
#   2) Pull a model:   ollama pull qwen2.5:7b   (or llama3.2:3b on lighter HW)
# The app auto-detects whichever chat model you've pulled.
BRAIN_ENGINE=local
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Optional (PAID): add an Anthropic key to use Claude instead of Ollama —
# stronger reasoning, better teaching, and LIVE web-news synthesis. Get one at
# https://console.anthropic.com . Leave blank to stay fully local & free.
ANTHROPIC_API_KEY=
ARIA_MODEL=claude-opus-4-8

# Live web-news synthesis (the action plan reaching the open web) uses Claude's
# web search — Claude only. On by default when a key is set; "false" disables it.
BRAIN_WEB_SEARCH=true

# Wake word the Web Speech fallback listens for (case-insensitive). Default: "aria".
ARIA_WAKE_WORD=aria

# Optional: extra persona / behavior appended to the brain's system prompt.
# e.g. "Be terse. Address me as 'Chief'. Prefer European exchanges."
ARIA_PERSONA=

# --- Voice recognition (push-to-talk) ---
# Default engine is fully LOCAL: on-device Whisper (transformers.js). Audio
# never leaves your machine; only the model weights download once.
#   npm install      (pulls optional @huggingface/transformers)
#   npm run model    (optional: pre-download weights so it's offline-ready)
# Engine: "local" (default) or "whisper-api" (cloud, opt-in).
STT_ENGINE=local
# Local model — tiny.en is fast; use base.en/small.en for more accuracy.
WHISPER_MODEL=Xenova/whisper-tiny.en
STT_MODEL_DIR=

# Only used if STT_ENGINE=whisper-api:
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Productivity: Google (Gmail read + Calendar read/ADD) — FREE ---
# Lets ARIA read unread Gmail + today's agenda AND add events to your Google
# Calendar (which then sync to your phone). The OAuth client is free to create:
#   1) https://console.cloud.google.com → APIs & Services → Credentials →
#      Create credentials → OAuth client ID → type "Desktop app".
#   2) Enable the Gmail API and Google Calendar API for the project.
#   3) Paste the client id/secret below.
# Then click Connect in the app's Connections panel and approve the calendar
# permission. Leave blank to disable Google features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Market data: real-time quotes (optional, FREE key) ---
# Default is the free Yahoo feed (no key) — fast, but quotes can be ~15 min
# delayed. For real-time ticks, get a FREE key and paste it here:
#   • Finnhub (recommended): https://finnhub.io/register → free real-time US
#     stock quotes. Set MARKETDATA_PROVIDER=finnhub and paste the key below.
# Provider: none (default) | finnhub | polygon | alpaca
MARKETDATA_PROVIDER=none
MARKETDATA_API_KEY=

# --- Trading account (Alpaca) — FREE paper keys ---
# You do NOT put broker keys here — get FREE paper-trading keys at
# https://alpaca.markets (Paper account → API keys) and connect them in the
# app's Connections panel (stored encrypted on-device). Paper is the default;
# live is opt-in.

# --- iMessage bridge (macOS only) ---
# Text ARIA from your iPhone (messages sync to your Mac) and get replies back.
# Requires running ARIA on a Mac with Full Disk Access + Automation permission.
# SAFETY: ARIA only answers handles you list here; empty = never responds.
IMESSAGE_ENABLED=false
IMESSAGE_ALLOW=                 # e.g. +15551234567,you@icloud.com
IMESSAGE_TRIGGER=aria          # optional: only answer texts starting with this
IMESSAGE_ALERTS=true           # also text price alerts to your phone

# --- Telegram bridge (works on Windows / anywhere) ---
# The phone channel for non-Mac systems. In Telegram: talk to @BotFather →
# /newbot → paste the token below. Then message your bot once and put your
# @username (or chat id) in the allowlist.
# SAFETY: ARIA only answers allowlisted users; empty = never responds.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW=                # e.g. yourusername  (no @) or a numeric chat id
TELEGRAM_ALERTS=true           # also send price alerts to your phone
