# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required for the conversational / voice brain (natural-language commands).
# Stock data panels work WITHOUT this key; only the AI brain needs it.
ANTHROPIC_API_KEY=

# Optional model override. Defaults to claude-opus-4-8.
ARIA_MODEL=claude-opus-4-8

# Wake word the voice layer listens for (case-insensitive). Default: "aria".
ARIA_WAKE_WORD=aria

# --- Productivity: Google (Gmail + Calendar) ---
# Create an OAuth client of type "Desktop app" in Google Cloud Console, enable
# the Gmail API and Google Calendar API, then paste the client id/secret here.
# Read-only scopes are requested. Leave blank to disable Google features.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Trading account (Alpaca) ---
# You do NOT put broker keys here — connect them in the app's Connections panel
# (stored encrypted on-device). Paper is the default; live is opt-in.
